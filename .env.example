# PostgreSQL. Neon and Supabase both work; local Postgres is fine for development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsepoll"

# Upstash Redis REST. The polled GET and the rate limiters talk to Redis over HTTP.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"
